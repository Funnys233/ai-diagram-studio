# 使用 node scripts/cloud-tools.cjs setup --origin https://draw.example.com 生成 .env.cloud
# 不要提交真实 .env.cloud。新数据目录首次启动会创建管理员；已有账号不受此初始密码影响。
APP_MODE=cloud
PUBLIC_ORIGIN=https://draw.example.com
HOST=127.0.0.1
PORT=8080
CLOUD_DATA_DIR=./data/cloud
CLOUD_MASTER_KEY=REPLACE_WITH_GENERATED_32_BYTE_BASE64
CLOUD_ADMIN_USERNAME=admin
CLOUD_ADMIN_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
CLOUD_USER_DAILY_LIMIT=200
CLOUD_PLATFORM_DAILY_LIMIT=200
# 全站所有来源的调用总量仅统计，不设每日上限
CLOUD_USER_CONCURRENCY=1
CLOUD_TOTAL_CONCURRENCY=4
CLOUD_WEEKLY_POINTS=1000
CLOUD_FREE_MODELS='[]'
DSH_AGENT_ENABLED=false
DSH_PUBLIC_ENABLED=false
REQUEST_TIMEOUT_MS=300000
MODEL_LIST_TIMEOUT_MS=15000

# 可选：仅服务器所有者本人使用订阅，省略则关闭；必须为现有管理员
# CLOUD_CHATGPT_OWNER=admin
