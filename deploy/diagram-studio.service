[Unit]
Description=Diagram Studio cloud
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=diagram
Group=diagram
WorkingDirectory=/opt/ai-diagram-studio
EnvironmentFile=/etc/diagram-studio.env
ExecStart=/usr/bin/node /opt/ai-diagram-studio/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/diagram-studio
MemoryMax=512M
[Install]
WantedBy=multi-user.target
